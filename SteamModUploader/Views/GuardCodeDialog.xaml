<Window x:Class="SteamModUploader.GuardCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Guard 验证码" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F4F8" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="Steam 需要输入验证码（Steam Guard）才能完成登录："
                   Foreground="#2A475E" TextWrapping="Wrap" FontSize="13"/>
        <TextBox x:Name="CodeBox" Margin="0,10,0,0" Padding="6,6" FontSize="16"
                 BorderBrush="#D4D9E3" BorderThickness="1"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="86" Margin="0,0,10,0" Padding="0,6"
                    Click="Ok_Click" IsDefault="True" FontSize="13"/>
            <Button Content="取消" Width="86" Padding="0,6"
                    Click="Cancel_Click" IsCancel="True" FontSize="13"/>
        </StackPanel>
    </StackPanel>
</Window>
