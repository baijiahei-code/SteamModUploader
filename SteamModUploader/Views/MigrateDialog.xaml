<Window x:Class="SteamModUploader.MigrateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迁移向导 - 导入已有文件夹" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F4F8" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="将已有的 MOD 文件夹内容迁移到当前 MOD 的统一目录结构（content 文件夹）中。"
                   Foreground="#5B6472" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="来源文件夹（已有 MOD 内容，如 paks 目录）" Foreground="#5B6472" FontSize="12" Margin="0,0,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SourceBox" Grid.Column="0" Padding="6,5" FontSize="13" BorderBrush="#D4D9E3" BorderThickness="1"/>
            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,6" Click="BrowseSource_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="迁移方式：" Foreground="#5B6472" FontSize="12" VerticalAlignment="Center"/>
            <RadioButton x:Name="CopyRadio" Content="复制（保留原文件）" GroupName="Mode" IsChecked="True" FontSize="12.5" VerticalAlignment="Center"/>
            <RadioButton x:Name="MoveRadio" Content="移动（迁移后原文件夹为空）" GroupName="Mode" FontSize="12.5" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="预览图文件（可选，迁移后自动作为 MOD 预览图）" Foreground="#5B6472" FontSize="12" Margin="0,14,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PreviewBox" Grid.Column="0" Padding="6,5" FontSize="13" BorderBrush="#D4D9E3" BorderThickness="1"/>
            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,6" Click="BrowsePreview_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="开始迁移" Width="96" Margin="0,0,10,0" Padding="0,7" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Padding="0,7" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
