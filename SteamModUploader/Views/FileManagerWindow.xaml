<Window x:Class="SteamModUploader.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件管理（全局）" Height="700" Width="1000"
        MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F8" Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E2E6EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#5B6472"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2838"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="AppTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#D4D9E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2A475E"/>
            <Setter Property="BorderBrush" Value="#C7CFDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF3F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#D64545"/>
            <Setter Property="BorderBrush" Value="#E8B4B4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBEEEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部：根目录（全局设置） ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁 文件管理（全局）" FontSize="16" FontWeight="Bold" Foreground="#1B2838" VerticalAlignment="Center"/>
                    <Button Content="打开根目录" Click="OpenRoot_Click" Style="{StaticResource GhostButton}" Margin="14,0,0,0"/>
                    <Button Content="刷新" Click="Refresh_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="MOD 文件根目录（全局设置，所有 MOD 文件统一在此下管理）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RootDirBox" Grid.Column="0" Style="{StaticResource AppTextBox}" TextChanged="RootDirBox_TextChanged"/>
                    <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseRoot_Click" Style="{StaticResource GhostButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ 中部：MOD 列表 + 文件详情 ============ -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：根目录下的 MOD 文件夹列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="根目录下的 MOD" Style="{StaticResource CardTitle}" Margin="0,0,0,0"/>
                    </DockPanel>
                    <ListBox x:Name="FolderList" SelectionChanged="FolderList_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="#F6F8FB" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#DCEBFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EEF3FA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#22303F" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Info}" FontSize="11" Foreground="#8A93A3" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：选中 MOD 的文件详情 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="ModTitleText" Text="（请在左侧选择 MOD）" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>

                        <WrapPanel>
                            <Button Content="创建标准目录结构" Click="CreateStructure_Click" Style="{StaticResource GhostButton}"/>
                            <Button Content="打开内容文件夹" Click="OpenContent_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                            <Button Content="打包发布版 zip" Click="PackageRelease_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                        </WrapPanel>

                        <TextBlock Text="内容文件（content 文件夹）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="ContentFileList" Grid.Column="0" Height="130" FontSize="12"
                                     BorderBrush="#D4D9E3" BorderThickness="1"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="导入内容文件…" Click="ImportContent_Click" Style="{StaticResource GhostButton}" Padding="10,5"/>
                                <Button Content="迁移向导…" Click="Migrate_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="预览图（preview 文件夹）" Style="{StaticResource FieldLabel}"/>
                                <Border BorderBrush="#E2E6EF" BorderThickness="1" CornerRadius="6" Padding="8"
                                        Background="#FAFBFD" MaxHeight="150">
                                    <Grid>
                                        <TextBlock x:Name="NoPreviewText" Text="（暂无预览图）" Foreground="#9AA4B2" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="PreviewImage" MaxHeight="130" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button Content="导入预览图…" Click="ImportPreview_Click" Style="{StaticResource GhostButton}" Padding="10,5"/>
                                <CheckBox x:Name="AutoBackupCheck" Content="上传前自动备份" FontSize="12" Margin="0,8,0,0"
                                          Checked="AutoBackup_Changed" Unchecked="AutoBackup_Changed"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="版本备份（backup 文件夹）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="BackupList" Grid.Column="0" Height="88" FontSize="12"
                                     BorderBrush="#D4D9E3" BorderThickness="1"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="创建备份" Click="CreateBackup_Click" Style="{StaticResource GhostButton}" Padding="10,5"/>
                                <Button Content="恢复所选" Click="RestoreBackup_Click" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,6,0,0"/>
                                <Button Content="删除所选" Click="DeleteBackup_Click" Style="{StaticResource DangerButton}" Padding="10,5" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ============ 底部：操作日志 ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="操作日志" FontSize="13" FontWeight="Bold" Foreground="#1B2838" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="清空" Click="ClearLog_Click" Style="{StaticResource GhostButton}"
                            Padding="10,4" FontSize="12"/>
                </DockPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                         Background="#1B2230" Foreground="#D6E1F0"
                         BorderThickness="0" Padding="10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
