<Window x:Class="SteamModUploader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam MOD 上传工具" Height="780" Width="1160"
        MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F8"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Window.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E2E6EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#5B6472"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2838"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="AppTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#D4D9E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="AppComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A9FFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B8FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#167FC9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2A475E"/>
            <Setter Property="BorderBrush" Value="#C7CFDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF3F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#D64545"/>
            <Setter Property="BorderBrush" Value="#E8B4B4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBEEEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <!-- ======================= 顶部标题 ======================= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🚀" FontSize="26" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Steam MOD 上传工具" FontSize="19" FontWeight="Bold" Foreground="#1B2838"/>
                    <TextBlock Text="自动生成 mod.vdf 并通过 steamcmd 上传 Steam 创意工坊" FontSize="12" Foreground="#5B6472" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁 文件管理（全局）" Click="OpenFileManager_Click" Style="{StaticResource GhostButton}"/>
                    <TextBlock Text="v1.0.0" FontSize="12" Foreground="#9AA4B2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= 中部：MOD 列表 + 表单 ======================= -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：MOD 列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MOD 列表" Style="{StaticResource CardTitle}"/>

                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="0,10,0,0"
                            BorderBrush="#E9EDF4" BorderThickness="0,1,0,0">
                        <WrapPanel>
                            <Button Content="新建" Click="NewProfile_Click" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="0,7" MinWidth="54"/>
                            <Button Content="复制" Click="DuplicateProfile_Click" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="0,7" MinWidth="54"/>
                            <Button Content="导入" Click="ImportVdf_Click" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="0,7" MinWidth="54"/>
                            <Button Content="删除" Click="DeleteProfile_Click" Style="{StaticResource DangerButton}" Padding="0,7" MinWidth="54"/>
                        </WrapPanel>
                    </Border>

                    <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="#F6F8FB" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#DCEBFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EEF3FA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#22303F" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="#8A93A3" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：MOD 信息表单 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <TextBlock Text="MOD 信息" Style="{StaticResource CardTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="显示名称（仅本地管理）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="创意工坊标题（title）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TitleBox" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="游戏 AppID（appid）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AppIdBox" Style="{StaticResource AppTextBox}" Text="2868840"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="可见性（visibility）" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="VisibilityBox" Style="{StaticResource AppComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="公开（Public）"/>
                                    <ComboBoxItem Content="仅好友（Friends）"/>
                                    <ComboBoxItem Content="私密（Private）"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="版本 / 更新说明（changenote）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="VersionBox" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="内容文件夹（contentfolder）" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ContentFolderBox" Grid.Column="0" Style="{StaticResource AppTextBox}"/>
                                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                                        Tag="ContentFolderBox" Click="BrowseFolder_Click" Style="{StaticResource GhostButton}"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="预览图（previewfile，可选）" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PreviewBox" Grid.Column="0" Style="{StaticResource AppTextBox}" TextChanged="PreviewBox_TextChanged"/>
                                    <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                                            Tag="PreviewBox" Click="BrowseFile_Click" Style="{StaticResource GhostButton}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PublishedFileID（更新专用）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PublishedIdBox" Style="{StaticResource AppTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 预览图实时预览 -->
                        <Border Margin="0,12,0,0" BorderBrush="#E2E6EF" BorderThickness="1" CornerRadius="6"
                                Padding="8" Background="#FAFBFD" MaxHeight="180">
                            <Grid>
                                <TextBlock x:Name="NoPreviewText" Text="（暂无预览图，可点击下方「导入预览图」选择）"
                                           Foreground="#9AA4B2" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PreviewImage" MaxHeight="160" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="VDF 保存路径（可选，默认使用临时目录）" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VdfPathBox" Grid.Column="0" Style="{StaticResource AppTextBox}"/>
                                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                                        Tag="VdfPathBox" Click="BrowseSaveFile_Click" Style="{StaticResource GhostButton}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="生成 VDF 预览" Click="PreviewVdf_Click" Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1" Content="打开内容文件夹" Click="OpenContentFolder_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" x:Name="UploadButton" Content="🚀 立即上传" Click="UploadButton_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="HintText" Margin="0,10,0,0" FontSize="11.5" Foreground="#8A93A3"
                                   TextWrapping="Wrap" Text="提示：首次上传请留空 PublishedFileID；上传成功后软件会自动识别并填入该 ID，之后勾选即可用于更新。"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ======================= steamcmd 设置栏 ======================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="steamcmd.exe 路径" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SteamCmdPathBox" Grid.Column="0" Style="{StaticResource AppTextBox}"/>
                        <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0"
                                Tag="SteamCmdPathBox" Click="BrowseFile_Click" Style="{StaticResource GhostButton}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Width="180">
                    <TextBlock Text="Steam 用户名" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SteamUserBox" Style="{StaticResource AppTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Width="180">
                    <TextBlock Text="Steam 密码" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="SteamPassBox" Padding="6,5" FontSize="13"
                                 BorderBrush="#D4D9E3" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource GhostButton}" Padding="16,8"/>
                    <Button Content="清除缓存" Click="ClearSteamCmdCache_Click" Style="{StaticResource GhostButton}"
                            Padding="16,8" Margin="8,0,0,0"
                            ToolTip="清除 steamcmd 的缓存登录凭据（config.vdf）。修改 Steam 密码后旧缓存失效、上传报 Access Denied 时使用；清除前自动备份到 config.vdf.bak"/>
                    <Button Content="修复路径" Click="RepairPaths_Click" Style="{StaticResource GhostButton}"
                            Padding="16,8" Margin="8,0,0,0"
                            ToolTip="检测并批量修复因移动文件夹而失效的路径（根目录/内容文件夹/预览图/VDF）。移动项目后，选择新的 MOD 根目录即可一键替换所有旧路径"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <TextBlock Text="密码经 DPAPI 加密保存，且不出现于命令行" FontSize="11" Foreground="#B0B8C6" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= 日志 ======================= -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="上传日志" FontSize="13" FontWeight="Bold" Foreground="#1B2838" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BusyBar" Width="150" Height="14" IsIndeterminate="True"
                                 Visibility="Collapsed" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="导出日志" Click="ExportLog_Click" Style="{StaticResource GhostButton}"
                            Padding="10,4" FontSize="12"/>
                    <Button DockPanel.Dock="Right" Content="清空" Click="ClearLog_Click" Style="{StaticResource GhostButton}"
                            Padding="10,4" FontSize="12" Margin="0,0,8,0"/>
                    <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="取消上传" Click="CancelUpload_Click"
                            Style="{StaticResource DangerButton}" Padding="10,4" FontSize="12"
                            Margin="0,0,8,0" Visibility="Collapsed"/>
                </DockPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                         Background="#1B2230" Foreground="#D6E1F0"
                         BorderThickness="0" Padding="10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
